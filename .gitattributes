# 文本默认在仓库和工作区使用 LF，避免不同系统产生整文件行尾差异。
# 下方的 Windows 批处理单独配置检出行尾。已跟踪文件在重新加入索引时才会重新规范化。

* text=auto eol=lf

# 明确按文本处理
*.md      text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.toml    text eol=lf
*.txt     text eol=lf
*.sol     text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows 批处理必须保留 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制文件：不做任何转换，且不参与 diff
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.pptx    binary
*.zip     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary

# 语言统计：文档不计入代码行数
docs/**   linguist-documentation
*.md      linguist-documentation
