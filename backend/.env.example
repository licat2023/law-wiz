# 应用配置示例。
#
# 用法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，**绝不要提交**。
# 所有变量均可通过环境变量提供（前缀 LAWWIZ_），.env 只是本地开发的便利。
#
# ⚠️ 本节列出的默认值用于本地跑通，**生产环境必须覆盖带「必须覆盖」标记的项**。

# ---------- 运行环境 ----------
LAWWIZ_APP_ENV=development
LAWWIZ_DEBUG=true
# 开发环境用固定验证码 000000（见 05-接口设计 §8）。
# ⚠️ production 下必须为 false，否则启动校验会拒绝启动 —— 固定验证码上线
#    等于任何人可注册任意账号。
LAWWIZ_ALLOW_FIXED_VERIFY_CODE=true

# ---------- 数据库（MySQL 9.7）----------
# 本地开发建议用 docker compose 起依赖：见 deploy/docker-compose.dev.yml
#
# ⚠️ **数据库密码必须与 compose 里的 `MYSQL_PASSWORD` 一致，否则连不上。**
#    两边默认值都是 `changeme`，因此"克隆 + 起容器 + 复制本文件"即可跑通。
#    若只改了一边，报错是 `1045 Access denied for user`，而 /health 只会回报
#    `database: unavailable` —— 后端已为此加了日志（app/slices/health/router.py），
#    但根本上还是保持两边一致最省事。
LAWWIZ_DB_HOST=127.0.0.1
LAWWIZ_DB_PORT=3306
LAWWIZ_DB_USER=lawwiz
LAWWIZ_DB_PASSWORD=changeme
LAWWIZ_DB_NAME=law_wiz
LAWWIZ_DB_POOL_SIZE=5
LAWWIZ_DB_MAX_OVERFLOW=5

# ---------- Redis ----------
LAWWIZ_REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 令牌 ----------
# ⚠️ 生产必须覆盖：生成方式 `python -c "import secrets;print(secrets.token_urlsafe(48))"`
LAWWIZ_JWT_SECRET=dev-only-insecure-secret-change-me
LAWWIZ_ACCESS_TOKEN_TTL_SECONDS=1800

# ---------- 文件存储 ----------
# 本地开发用 local（写到磁盘），生产用 minio
LAWWIZ_STORAGE_BACKEND=local
LAWWIZ_STORAGE_LOCAL_ROOT=./.data/files
LAWWIZ_MINIO_ENDPOINT=127.0.0.1:9000
LAWWIZ_MINIO_ACCESS_KEY=
LAWWIZ_MINIO_SECRET_KEY=
LAWWIZ_MINIO_BUCKET=lawwiz

# ---------- 向量存储 ----------
# memory = 进程内简易实现（无需依赖，供开箱即用）；
# chroma = 真实向量库，需 `uv sync --extra vector`，且**进程内运行、不单独起容器**
LAWWIZ_VECTOR_BACKEND=memory
LAWWIZ_CHROMA_PATH=./.data/chroma

# ---------- 外部能力 ----------
# 一期接云端 OCR：**服务器跑不动本地 OCR**（本地 OCR 需 1.2–2 GB 内存，见 02-技术栈 §3.9）
LAWWIZ_OCR_PROVIDER=stub
LAWWIZ_OCR_API_BASE=
LAWWIZ_OCR_API_KEY=

# LLM：stub 用于开发（返回固定结构，不消耗额度）；deepseek / ollama 为真实通道
LAWWIZ_LLM_PROVIDER=stub
LAWWIZ_LLM_API_BASE=https://api.deepseek.com/v1
LAWWIZ_LLM_API_KEY=
LAWWIZ_LLM_MODEL=deepseek-chat

LAWWIZ_EMBEDDING_PROVIDER=stub
LAWWIZ_EMBEDDING_API_BASE=
LAWWIZ_EMBEDDING_API_KEY=
LAWWIZ_EMBEDDING_MODEL=
LAWWIZ_EMBEDDING_DIM=1024
