# 复制为 .env.dev。仅用于本机容器开发及演示。
LAWWIZ_FRONTEND_PORT=5173
KB_FRONTEND_PORT=5174
LAWWIZ_BACKEND_PORT=8000
KB_BACKEND_PORT=8100
LAWWIZ_DEV_DB_PORT=3306
LAWWIZ_DEV_REDIS_PORT=6379

KB_ADMIN_USERNAME=admin
# bcrypt 哈希用单引号包围，保留其中的 $。
KB_ADMIN_PASSWORD_HASH=
KB_JWT_SECRET=
# 首次创建默认库后，按部署说明填写映射及业务端的对应值。
KB_SERVICE_KEYS_JSON='{}'
LAWWIZ_KNOWLEDGE_BASE_SERVICE_KEY=
LAWWIZ_KNOWLEDGE_BASE_DEFAULT_ID=

# 连接真实服务时关闭模型替身并切换远程嵌入，填写对应配置。
LAWWIZ_ALLOW_FAKE_MODEL=true
LAWWIZ_AI_SERVICE_TOKEN=development-ai-token
LAWWIZ_AI_SERVICE_TIMEOUT_SECONDS=65
LAWWIZ_STORAGE_S3_BUCKET=lawwiz-files
LAWWIZ_MODEL_API_KEY=
LAWWIZ_MODEL_BASE_URL=
LAWWIZ_MODEL_NAME=
KB_EMBEDDING_MODE=development
KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=
KB_EMBEDDING_DIMENSIONS=1536

# 开发环境也可使用独立重排服务。
KB_RETRIEVAL_STRATEGY=hybrid
KB_RERANK_ENDPOINT=
KB_RERANK_API_KEY=
