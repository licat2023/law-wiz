# 生产环境变量模板（配合 docker-compose.prod.yml 使用）。
#
# 用法（在 deploy/ 目录下）：
#   cp .env.example .env      # Windows: Copy-Item .env.example .env
#   # 然后按下面的「必填」逐项填写
#
# ⚠️ `deploy/.env` 已被 .gitignore 忽略，**绝不要提交**（凭据纪律，见根 README）。
# ⚠️ compose 会自动读取本目录的 `.env`：既用于 `${VAR}` 插值（MySQL 密码），
#    也作为 backend 容器的环境变量（Settings 读 `LAWWIZ_*`）。改完需 `up -d` 重启生效。

# ---------- 应用 ----------
LAWWIZ_APP_ENV=production
LAWWIZ_DEBUG=false
# ⚠️ 生产必须为 false：固定验证码 000000 上线等于任何人可注册任意账号。
#    （后端启动校验也会拒绝，但别依赖它——配置里就写对。）
LAWWIZ_ALLOW_FIXED_VERIFY_CODE=false

# ---------- 令牌 ----------
# 【必填】生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 用开发默认值等于没有鉴权。
LAWWIZ_JWT_SECRET=

# ---------- MySQL ----------
# 主机/端口由 compose 注入（指向 mysql 服务），此处不用填。
LAWWIZ_DB_NAME=law_wiz
LAWWIZ_DB_USER=lawwiz
# 【必填】同时用于初始化 MySQL 与后端连接，两边必须一致
LAWWIZ_DB_PASSWORD=
# 【必填】MySQL root 密码（仅用于健康检查与运维）
LAWWIZ_MYSQL_ROOT_PASSWORD=

# ---------- 文件存储 ----------
# 一期只有 local：写入容器内 /app/.data（已挂命名卷 lawwiz-data）
LAWWIZ_STORAGE_BACKEND=local
LAWWIZ_STORAGE_LOCAL_ROOT=/app/.data

# ---------- 向量存储 ----------
# 一期为进程内实现，不单独起容器（省内存）
LAWWIZ_VECTOR_BACKEND=memory

# ---------- 外部能力 ----------
# OCR 走云端 API（服务器跑不动本地 OCR）。
LAWWIZ_OCR_PROVIDER=cloud
LAWWIZ_OCR_API_BASE=
LAWWIZ_OCR_API_KEY=

# LLM：deepseek / ollama 为真实通道；**禁止 fake**（启动校验会拒绝它）。
# 未配置真实通道时先填 stub —— 任务会以「AI 未接入」明确失败，而不是产出假结论。
LAWWIZ_LLM_PROVIDER=stub
LAWWIZ_LLM_API_BASE=https://api.deepseek.com/v1
LAWWIZ_LLM_API_KEY=
LAWWIZ_LLM_MODEL=deepseek-chat

LAWWIZ_EMBEDDING_PROVIDER=stub
LAWWIZ_EMBEDDING_API_BASE=
LAWWIZ_EMBEDDING_API_KEY=
LAWWIZ_EMBEDDING_MODEL=
LAWWIZ_EMBEDDING_DIM=1024
