# 复制为 deploy/.env 后填写；Compose仅向各服务注入所需字段。
LAWWIZ_JWT_SECRET=
LAWWIZ_DB_NAME=law_wiz
LAWWIZ_DB_USER=lawwiz
LAWWIZ_DB_PASSWORD=
LAWWIZ_MYSQL_ROOT_PASSWORD=
LAWWIZ_BACKEND_PORT=8000
LAWWIZ_FRONTEND_PORT=8080

# 独立 AI 服务的模型配置。
LAWWIZ_MODEL_API_KEY=
LAWWIZ_MODEL_BASE_URL=
LAWWIZ_MODEL_NAME=
LAWWIZ_MODEL_TIMEOUT_SECONDS=60
LAWWIZ_AI_SERVICE_TOKEN=
LAWWIZ_AI_SERVICE_TIMEOUT_SECONDS=65

# RustFS 业务桶及凭据。
LAWWIZ_STORAGE_S3_BUCKET=lawwiz-files
LAWWIZ_STORAGE_S3_ACCESS_KEY=
LAWWIZ_STORAGE_S3_SECRET_KEY=

# 独立知识库数据库；KB_DATABASE_URL中密码须URL编码。
KB_MYSQL_DATABASE=law_wiz_kb
KB_MYSQL_USER=lawwiz_kb
KB_MYSQL_PASSWORD=
KB_DATABASE_URL=
KB_BACKEND_PORT=8100
KB_FRONTEND_PORT=8180

# 管理员密码使用bcrypt哈希；含$的值用单引号包围，防止.env插值。
KB_ADMIN_USERNAME=admin
KB_ADMIN_PASSWORD_HASH=
KB_ADMIN_APPLICATION_ID=law-wiz
KB_JWT_SECRET=
KB_SERVICE_KEYS_JSON=
KB_CORS_ORIGINS=[]

# 业务后端与 AI 服务共用知识库只读授权。
LAWWIZ_KNOWLEDGE_BASE_SERVICE_KEY=
LAWWIZ_KNOWLEDGE_BASE_DEFAULT_ID=
# 写入兼容默认关闭；开启时必须同时配置独立writer key和业务管理员ID。
LAWWIZ_KNOWLEDGE_BASE_WRITER_KEY=
LAWWIZ_KNOWLEDGE_BASE_ADMIN_USER_IDS=[]

KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=
KB_EMBEDDING_DIMENSIONS=1536
KB_REQUEST_TIMEOUT_SECONDS=60

# 默认混合检索。启用 reranked 时配置独立的重排模型服务。
KB_RETRIEVAL_STRATEGY=hybrid
KB_RETRIEVAL_CANDIDATES=24
KB_RERANK_ENDPOINT=
KB_RERANK_API_KEY=
KB_RERANK_TIMEOUT_SECONDS=2
KB_RERANK_CANDIDATES=16
