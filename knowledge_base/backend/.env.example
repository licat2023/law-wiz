# 数据库需配置异步驱动，生产环境由独立命令初始化表结构。
KB_ENVIRONMENT=development
KB_DATABASE_URL=
KB_AUTO_CREATE_SCHEMA=false
KB_DATA_ROOT=.data

# 管理端使用 bcrypt 密码哈希和 JWT 签名密钥。
KB_ADMIN_USERNAME=admin
KB_ADMIN_PASSWORD_HASH=
KB_ADMIN_APPLICATION_ID=law-wiz
KB_JWT_SECRET=
KB_JWT_TTL_SECONDS=3600
# 服务密钥对应 application_id、knowledge_base_ids 和 reader 或 writer 角色。
KB_SERVICE_KEYS_JSON={}

# 开发嵌入只验证索引与检索流程，生产环境使用远程嵌入。
KB_EMBEDDING_MODE=remote
KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=
KB_EMBEDDING_DIMENSIONS=1536
KB_REQUEST_TIMEOUT_SECONDS=60

# 默认沿用向量检索。用管理端评测后可选择 hybrid 或 reranked。
KB_RETRIEVAL_STRATEGY=vector
KB_RETRIEVAL_CANDIDATES=24
# 可选 TEI 兼容的重排完整 URL。未配置或重排失败时使用 RRF 顺序。
KB_RERANK_ENDPOINT=
KB_RERANK_API_KEY=
KB_RERANK_TIMEOUT_SECONDS=2
KB_RERANK_CANDIDATES=16

# 处理器通过租约领取任务，过期任务可按最大次数重新领取。
KB_WORKER_ENABLED=true
KB_WORKER_POLL_SECONDS=1
KB_LEASE_SECONDS=300
KB_MAX_ATTEMPTS=3

# 上传、解析和切分限制独立配置。父块上下文字数另设预算。
KB_MAX_UPLOAD_BYTES=20971520
KB_MAX_TEXT_CHARS=2000000
KB_MAX_PDF_PAGES=300
KB_MAX_CHUNKS=10000
KB_PARENT_CONTEXT_CHARS=8000
KB_CORS_ORIGINS=[]
